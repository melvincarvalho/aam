{
  "name": "Test ES Module Agent",
  "description": "An agent created to test ES modules",
  "url": "https://example.com/test-esm",
  "version": "1.0.0",
  "provider": {
    "name": "Example Provider",
    "url": "https://example.com"
  },
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "multiTurn": true
  },
  "authentication": {
    "schemes": [
      {
        "type": "Bearer",
        "description": "JWT token authentication"
      }
    ]
  },
  "skills": [
    {
      "id": "echo",
      "name": "Echo",
      "description": "Returns the input text back to the sender",
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "examples": [
        {
          "input": {
            "text": "Hello, agent!"
          },
          "output": {
            "text": "Hello, agent!"
          }
        }
      ]
    },
    {
      "id": "ping",
      "name": "Ping",
      "description": "Responds to a ping request with a status message",
      "inputModes": [
        "text"
      ],
      "outputModes": [
        "text"
      ],
      "examples": [
        {
          "input": {
            "text": "ping"
          },
          "output": {
            "text": "pong! Agent is online and responding."
          }
        }
      ]
    }
  ]
}